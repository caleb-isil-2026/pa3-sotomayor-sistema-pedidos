@startuml arquitectura_pa3_reportes
' Sistema de Pedidos - PA3: modulo de consulta y supervision
' Diagrama de componentes UML 2 (Spring Boot 4.1)
skinparam monochrome true
skinparam shadowing false
skinparam componentStyle uml2
skinparam linetype polyline
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 45
skinparam ranksep 50
skinparam dpi 150
skinparam packageStyle rectangle

title Sistema de Pedidos - Diagrama de componentes del módulo de reportes (PA3)

actor "Usuario\n(OPERADOR, CONSULTA)" as usuario
node "Navegador web" as navegador

node "Servidor de aplicaciones\nSpring Boot 4.1 · Tomcat embebido · :8081" {

  package "Seguridad" {
    [SecurityFilterChain] as security
  }

  package "Presentación (Spring MVC)" {
    [DispatcherServlet] as dispatcher
    [PedidoReporteWebController] as webCtl
    [PedidoReporteController] as restCtl
    [PedidoController] as pedidoCtl
    [ReporteApiExceptionHandler] as advice
    artifact "reportes-pedidos.jsp" as jsp
  }

  package "Negocio" {
    () "PedidoReporteService" as iReporte
    () "PedidoService" as iPedido
    [PedidoReporteServiceImpl] as reporteSvc
    [PedidoServiceImpl] as pedidoSvc
  }

  package "Acceso a datos" {
    [PedidoReporteJdbcRepository\n(Spring JDBC)] as jdbcRepo
    [PedidoRepository\n(Spring Data JPA)] as jpaRepo
    [InventarioRestClient\n(RestClient)] as invClient
  }
}

database "MySQL 8\npedidosdb" as mysql
node "inventario-service\nJakarta EE · WildFly · :8082" as inventario

usuario -down-> navegador
navegador -down-> security : HTTP
security -down-> dispatcher : petición autenticada\ny autorizada por rol
dispatcher -down-> webCtl : GET /reportes/pedidos
dispatcher -down-> restCtl : GET /api/v1/pedidos/**
dispatcher -down-> pedidoCtl : GET, POST /pedidos
webCtl -right-> jsp : Model
restCtl .right.> advice : <<handles>>

reporteSvc -up- iReporte
pedidoSvc -up- iPedido
webCtl -down-( iReporte
restCtl -down-( iReporte
pedidoCtl -down-( iPedido

reporteSvc -down-> jdbcRepo
pedidoSvc -down-> jpaRepo
pedidoSvc -down-> invClient

jdbcRepo -down-> mysql : JDBC\nSQL parametrizado
jpaRepo -down-> mysql : JDBC\nHibernate
invClient -down-> inventario : HTTP/JSON
@enduml
